[Unit]
Description=Crankspan Bike Wear Tracker
After=network.target

[Service]
Type=simple
User=agentpi
WorkingDirectory=/home/agentpi/projects/crankspan
ExecStart=/home/agentpi/projects/crankspan/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8082
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
